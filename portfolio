      <div class="skill-item">Responsive Design</div>
      <div class="skill-item">Git & GitHub</div>
      <div class="skill-item">Basic JavaScript</div>
    </div>
  </section>

  <!-- Projects Section (3 Cards) -->
  <section id="projects">
    <h2 class="section-title">Featured Projects</h2>
    <div class="projects-grid">

      <!-- Card 1 -->
      <article class="project-card">
        <div>
          <p class="project-tag">Project 01</p>
          <h3>Roast &amp; Brew Café</h3>
          <p>A responsive landing page for a local coffee shop featuring a seasonal menu grid, opening hours, and location map.</p>
          <div class="project-tech">
            <span>HTML5</span>
            <span>CSS Grid</span>
            <span>Responsive</span>
          </div>
        </div>
        <a href="#" class="project-link">Live Demo &rarr;</a>
      </article>

      <!-- Card 2 -->
      <article class="project-card">
        <div>
          <p class="project-tag">Project 02</p>
          <h3>TaskFlow Dashboard</h3>
          <p>A clean productivity layout designed to organize daily tasks and project milestones with a dark-mode user interface.</p>
          <div class="project-tech">
            <span>HTML5</span>
            <span>Flexbox</span>
            <span>UI Design</span>
          </div>
        </div>
        <a href="#" class="project-link">Live Demo &rarr;</a>
      </article>

      <!-- Card 3 -->
      <article class="project-card">
        <div>
          <p class="project-tag">Project 03</p>
          <h3>TechPulse Blog</h3>
          <p>A multi-article editorial template built with semantic HTML and custom typography for effortless mobile reading.</p>
          <div class="project-tech">
            <span>Semantic HTML</span>
            <span>CSS Variables</span>
          </div>
        </div>
        <a href="#" class="project-link">Live Demo &rarr;</a>
      </article>

    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact">
    <h2 class="section-title">Get In Touch</h2>
    <div class="contact-box">
      <p>
        I'm currently open to freelance projects, internships, and collaboration opportunities. Feel free to reach out!
      </p>
      <a href="mailto:hello@example.com" class="btn">Say Hello</a>
      <div class="social-links">
        <a href="https://github.com" target="_blank" rel="noopener">GitHub</a>
        <span>•</span>
        <a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a>
        <span>•</span>
        <a href="https://x.com" target="_blank" rel="noopener">X / Twitter</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <p>&copy; 2026 Alex Rivera. Built with HTML &amp; CSS.</p>
  </footer>

</body>
</html>
