<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Harsh Raj | Web Developer Portfolio</title>
  <style>
    /* --- CSS Variables & Reset --- */
    :root {
      --bg-navy: #0a192f;
      --bg-navy-light: #112240;
      --bg-navy-lighter: #1d3557;
      --accent-orange: #ff6b35;
      --accent-orange-hover: #e85a26;
      --text-primary: #ccd6f6;
      --text-secondary: #8892b0;
      --white: #ffffff;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--bg-navy);
      color: var(--text-primary);
      line-height: 1.6;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* --- Navigation Bar & Mobile Menu --- */
    header {
      position: fixed;
      top: 0;
      width: 100%;
      background-color: rgba(10, 25, 47, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255, 107, 53, 0.2);
      z-index: 1000;
    }

    .nav-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--white);
      letter-spacing: 0.5px;
    }

    .logo span {
      color: var(--accent-orange);
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 2rem;
    }

    .nav-links a {
      color: var(--text-primary);
      font-size: 0.95rem;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .nav-links a:hover {
      color: var(--accent-orange);
    }

    /* Pure CSS Mobile Menu Toggle */
    #menu-toggle {
      display: none;
    }

    .hamburger {
      display: none;
      flex-direction: column;
      cursor: pointer;
      gap: 5px;
    }

    .hamburger span {
      width: 26px;
      height: 3px;
      background-color: var(--accent-orange);
      border-radius: 2px;
      transition: 0.3s;
    }

    /* --- Layout & Section Styling --- */
    section {
      max-width: 1100px;
      margin: 0 auto;
      padding: 6rem 2rem;
      scroll-margin-top: 60px;
    }

    .section-title {
      font-size: 2rem;
      color: var(--white);
      margin-bottom: 2.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .section-title::after {
      content: "";
      height: 2px;
      width: 120px;
      background-color: var(--accent-orange);
      display: inline-block;
    }

    /* --- Hero / About Section --- */
    #about {
      min-height: 90vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding-top: 8rem;
    }

    .hero-greeting {
      color: var(--accent-orange);
      font-weight: 600;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .hero-name {
      font-size: clamp(2.5rem, 6vw, 4.2rem);
      font-weight: 800;
      color: var(--white);
      line-height: 1.15;
    }

    .hero-subtitle {
      font-size: clamp(1.5rem, 4vw, 2.5rem);
      font-weight: 700;
      color: var(--text-secondary);
      margin-bottom: 1.5rem;
    }

    .about-text {
      max-width: 620px;
      color: var(--text-secondary);
      font-size: 1.05rem;
      margin-bottom: 2rem;
    }

    .btn {
      display: inline-block;
      background-color: var(--accent-orange);
      color: var(--white);
      padding: 0.85rem 1.75rem;
      border-radius: 6px;
      font-weight: 600;
      transition: background-color 0.3s ease, transform 0.2s ease;
    }

    .btn:hover {
      background-color: var(--accent-orange-hover);
      transform: translateY(-2px);
    }

    /* --- Skills Section --- */
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 1.2rem;
    }

    .skill-item {
      background-color: var(--bg-navy-light);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1.2rem;
      border-radius: 8px;
      text-align: center;
      font-weight: 600;
      color: var(--text-primary);
      transition: border-color 0.3s ease, transform 0.2s ease;
    }

    .skill-item:hover {
      border-color: var(--accent-orange);
      transform: translateY(-3px);
      color: var(--accent-orange);
    }

    /* --- Projects Section (3 Cards) --- */
    .projects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
      gap: 2rem;
    }

    .project-card {
      background-color: var(--bg-navy-light);
      border-radius: 10px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: transform 0.3s ease, border-color 0.3s ease;
    }

    .project-card:hover {
      transform: translateY(-6px);
      border-color: var(--accent-orange);
    }

    .project-tag {
      color: var(--accent-orange);
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 0.5rem;
    }

    .project-card h3 {
      color: var(--white);
      font-size: 1.35rem;
      margin-bottom: 0.75rem;
    }

    .project-card p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
    }

    .project-tech {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .project-tech span {
      background-color: var(--bg-navy);
      color: var(--text-primary);
      font-size: 0.8rem;
      padding: 0.25rem 0.65rem;
      border-radius: 4px;
    }

    .project-link {
      color: var(--accent-orange);
      font-weight: 600;
      font-size: 0.95rem;
    }

    .project-link:hover {
      text-decoration: underline;
    }

    /* --- Contact Section --- */
    .contact-box {
      background-color: var(--bg-navy-light);
      padding: 3rem 2rem;
      border-radius: 12px;
      text-align: center;
      max-width: 700px;
      margin: 0 auto;
      border: 1px solid rgba(255, 107, 53, 0.25);
    }

    .contact-box p {
      color: var(--text-secondary);
      margin-bottom: 2rem;
      font-size: 1.05rem;
    }

    .social-links {
      margin-top: 2rem;
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    .social-links a:hover {
      color: var(--accent-orange);
    }

    /* --- Footer --- */
    footer {
      text-align: center;
      padding: 2rem;
      color: var(--text-secondary);
      font-size: 0.9rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* --- Mobile Responsive Styles --- */
    @media (max-width: 768px) {
      .hamburger {
        display: flex;
      }

      .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: var(--bg-navy-light);
        flex-direction: column;
        align-items: center;
        gap: 0;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s ease;
        border-bottom: 1px solid rgba(255, 107, 53, 0.2);
      }

      .nav-links li {
        width: 100%;
        text-align: center;
      }

      .nav-links a {
        display: block;
        padding: 1rem;
      }

      #menu-toggle:checked ~ .nav-links {
        max-height: 300px;
      }
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <header>
    <div class="nav-container">
      <a href="#about" class="logo">Alex<span>.dev</span></a>
      <input type="checkbox" id="menu-toggle" />
      <label for="menu-toggle" class="hamburger" aria-label="Toggle Menu">
        <span></span>
        <span></span>
        <span></span>
      </label>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </header>

  <!-- About / Hero Section -->
  <section id="about">
    <p class="hero-greeting">Hi, my name is</p>
    <h1 class="hero-name">Alex Rivera.</h1>
    <h2 class="hero-subtitle">I build clean, responsive websites.</h2>
    <p class="about-text">
      I am a front-end web developer passionate about turning ideas into fast, accessible, and user-friendly web experiences. Currently focused on mastering modern HTML, CSS, and interactive web design.
    </p>
    <div>
      <a href="#projects" class="btn">View My Work</a>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills">
